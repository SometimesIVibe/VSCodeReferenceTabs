{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "out-test",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node", "mocha", "vscode"]
  },
  "include": [
    "src/test/**/*.ts",
    "src/store.ts",
    "src/persistence.ts",
    "src/search.ts",
    "src/model.ts",
    "src/labels.ts",
    "src/testProject.ts",
    "src/callTree.ts"
  ],
  "exclude": ["node_modules", "dist", "out", "out-test"]
}

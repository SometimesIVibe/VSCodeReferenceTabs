{
  "name": "vscode-reference-tabs",
  "displayName": "Reference Tabs",
  "description": "Find All References / Find All Implementations results as persistent, closable tabs in a dedicated panel view.",
  "version": "0.1.0",
  "publisher": "joachimsejr",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/joachimvocast/VSCodeReferenceTabs"
  },
  "keywords": [
    "references",
    "implementations",
    "panel",
    "tabs"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "referenceTabs",
          "title": "Reference Tabs",
          "icon": "$(references)"
        }
      ]
    },
    "views": {
      "referenceTabs": [
        {
          "type": "webview",
          "id": "referenceTabs.panel",
          "name": "Reference Tabs"
        }
      ]
    },
    "commands": [
      {
        "command": "referenceTabs.findReferences",
        "title": "Reference Tabs: Find All References",
        "shortTitle": "Find References (Tabs)"
      },
      {
        "command": "referenceTabs.findImplementations",
        "title": "Reference Tabs: Find All Implementations",
        "shortTitle": "Find Implementations (Tabs)"
      },
      {
        "command": "referenceTabs.clearAll",
        "title": "Reference Tabs: Clear All Tabs",
        "shortTitle": "Clear All",
        "icon": "$(clear-all)"
      },
      {
        "command": "referenceTabs.rerun",
        "title": "Reference Tabs: Re-run Search",
        "shortTitle": "Re-run",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "referenceTabs.rerun",
          "when": "view == referenceTabs.panel",
          "group": "navigation@1"
        },
        {
          "command": "referenceTabs.clearAll",
          "when": "view == referenceTabs.panel",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "referenceTabs.findReferences",
          "when": "editorHasReferenceProvider && editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "referenceTabs.findImplementations",
          "when": "editorHasImplementationProvider && editorTextFocus",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "referenceTabs.findReferences",
        "key": "ctrl+alt+a",
        "when": "editorHasReferenceProvider && editorTextFocus"
      },
      {
        "command": "referenceTabs.findImplementations",
        "key": "ctrl+alt+s",
        "when": "editorHasImplementationProvider && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Reference Tabs",
      "properties": {
        "referenceTabs.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Focus the Reference Tabs panel after running a search. When disabled, new/updated results are shown silently (the view badge still updates)."
        },
        "referenceTabs.maxSearches": {
          "type": "number",
          "default": 30,
          "description": "Maximum number of search tabs to keep. The oldest tab is evicted once this limit is exceeded."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
